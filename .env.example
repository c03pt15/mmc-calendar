# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email notifications (server-side, used by /api/send-task-notification)
# Create a free API key at https://resend.com and add these in Vercel
# Project Settings > Environment Variables (do NOT prefix them with VITE_).
RESEND_API_KEY=
MMC_FROM_EMAIL=MMC Calendar <do-not-reply@atlasinstitute.ca>

# Comma-separated list of MMC members who receive "Notify everyone" emails.
# While testing, leave this empty or set it to the admin address only.
MMC_NOTIFICATION_EMAILS=

# Comma-separated list of admin emails allowed to trigger notifications.
MMC_ADMIN_EMAILS=ghgirard@atlasinstitute.ca
